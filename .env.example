# Optional AI Analyst settings used by the exploratory workspace.
PIO_AI_API_KEY=replace-with-your-key
PIO_AI_BASE_URL=https://ai.gateway.lovable.dev
PIO_AI_MODEL=openai/gpt-5-mini

# Optional compatibility aliases.
# LOVABLE_API_KEY=replace-with-your-key
# LOVABLE_BASE_URL=https://ai.gateway.lovable.dev
# LOVABLE_MODEL=openai/gpt-5-mini

# Official Forecast API proxy (server-side only; never use NEXT_PUBLIC_).
# For the recommended single-host deployment, keep the Forecast API on :8100.
GOVERNED_FORECAST_API_URL=http://127.0.0.1:8100

# Must match FORECAST_API_KEY on the private forecasting backend.
# Choose the real value locally and never commit it.
GOVERNED_FORECAST_API_KEY=replace-with-the-same-private-api-key

GOVERNED_FORECAST_API_TIMEOUT_SECONDS=10
GOVERNED_FORECAST_SCHEMA_VERSION=1.2.0
